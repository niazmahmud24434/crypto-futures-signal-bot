# Telegram BotFather token. Never commit the real value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=9282726837
# Refuse commands from any other chat unless explicitly enabled.
TELEGRAM_ALLOW_OTHER_CHATS=false

# Public Binance Futures endpoints only. No API key or secret is required.
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
REQUEST_TIMEOUT_SECONDS=20
REQUEST_PAUSE_SECONDS=0.15

# Strategy and risk controls.
MIN_SIGNAL_SCORE=3
ENTRY_TIMEFRAME=15m
CONFIRMATION_TIMEFRAME=1h
REGIME_TIMEFRAME=4h
MAX_CANDLE_AGE_BARS=3
BLOCK_COUNTER_TREND=true
SIGNAL_COOLDOWN_MINUTES=180
TOP_VOLUME_LIMIT=20
CRYPTO_ONLY_UNIVERSE=true

# Local, Git-ignored storage for generated reports and signal history.
JOURNAL_PATH=data/signals.sqlite3
REPORT_DIRECTORY=reports
